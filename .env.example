# ============================================================
# CONSTRU-TRANS — VARIABLES DE ENTORNO
# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se sube a git.
# ============================================================

# --- DJANGO ---
# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-50-caracteres
DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings.development

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ============================================================
# BASES DE DATOS — MODO HÍBRIDO (local + nube)
# ============================================================
# La BD local SQLite (db.sqlite3) se crea automáticamente y
# permite trabajar OFFLINE. No requiere configuración.
#
# La BD remota Neon es para SINCRONIZAR datos entre compañeros.
# Si dejas DATABASE_URL vacía, todo el sistema usa solo SQLite local.
# Pídele al admin la URL real por Bitwarden.
# ============================================================
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# --- EMAIL (cuenta constru_trans para recuperación de contraseña) ---
# EMAIL_HOST_PASSWORD es un App Password de Gmail de 16 caracteres
# Generar en: `https://myaccount.google.com/apppasswords`
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=constru.trans@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=Constru-Trans <constru.trans@gmail.com>
EMAIL_TIMEOUT=30

# --- SEGURIDAD ---
PASSWORD_RESET_TIMEOUT=1800
SESSION_COOKIE_AGE=1209600
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# --- MONITOREO (opcional, solo producción) ---
SENTRY_DSN=

# --- ALMACENAMIENTO EN LA NUBE (opcional) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# --- TWILIO (opcional, SMS/WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
