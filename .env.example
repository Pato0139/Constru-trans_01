# ==========================================================
# Plantilla de variables de entorno — Constru-trans
# Copia este archivo a .env (el setup lo hace por ti) y ajusta lo necesario.
# ==========================================================

DJANGO_ENV=development
# El setup genera una clave aleatoria de forma automática.
# Si la dejas vacía, el proyecto crea una válida y la escribe en .env la primera vez.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Base de datos local (SQLite). Déjala vacía para trabajar sin conexión.
# Si defines una URL de PostgreSQL/Neon, pasa a ser la base 'default'
# y la SQLite queda disponible como base 'local'.
DATABASE_URL=

# --- Correo (recuperación de contraseña) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Constru-Trans <no-reply@example.com>
SERVER_EMAIL=Constru-Trans <no-reply@example.com>

# Alternativa con Resend (opcional, requiere dominio verificado)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Clima en el panel del conductor (opcional) ---
OPENWEATHER_API_KEY=

# --- Almacenamiento opcional en S3 ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# --- IA / LLM (opcional) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
WEB_SEARCH_ENABLED=False
BRAVE_API_KEY=

# --- Licenciamiento (opcional) ---
LICENSE_REQUIRED=False
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEY=
