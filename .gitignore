# Entornos y secretos (NUNCA subir)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Repositorio Neon (se clona durante setup)
neon-repo/

# Bases de datos locales (cada PC tiene la suya)
*.sqlite3
*.sqlite3-journal

# Backup opcional
db_backup.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Entornos virtuales
venv/
env/
.venv/
ENV/

# Django
*.log
local_settings.py
staticfiles/
collected_static/
logs/*.log

# Media (archivos subidos por usuarios)
