media/*
!media/.gitkeep
!media/perfiles/
!media/perfiles/**

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Tests y coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Docker
docker-compose.override.yml

# Backups SQL y dumps JSON
backups/*.sql
backups/*.dump
backups/*.json

*.djcache

